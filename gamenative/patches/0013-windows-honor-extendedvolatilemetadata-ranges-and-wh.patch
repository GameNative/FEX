@@ -247,6 +247,8 @@ public:
 
   void AddForceTSOInformation(const IntervalList<uint64_t>& ValidRanges, fextl::set<uint64_t>&& Instructions) override;
 
+  void AddTSODisabledRanges(const IntervalList<uint64_t>& Ranges) override;
+
   void RemoveForceTSOInformation(uint64_t Address, uint64_t Size) override;
 
   void MarkMonoDetected() override {
@@ -518,6 +520,7 @@ private:
   fextl::unordered_map<uint64_t, CustomIRHandlerEntry> CustomIRHandlers;
   IntervalList<uint64_t> ForceTSOValidRanges; // The ranges for which ForceTSOInstructions has populated data
   fextl::set<uint64_t> ForceTSOInstructions;
+  IntervalList<uint64_t> TSODisabledRanges; // Configured ranges that need no TSO, with no per-instruction data
 
   bool MonoDetected = false;
   std::atomic<uint64_t> MonoBackpatcherBlock;
diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index 65c21f887..6aa88d9d1 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -661,6 +661,7 @@ ContextImpl::GenerateIR(FEXCore::Core::InternalThreadState* Thread, uint64_t Gue
 #endif
 
       bool BlockInForceTSOValidRange = false;
+      bool BlockInTSODisabledRange = false;
       auto InstForceTSOIt = ForceTSOInstructions.end();
       if (ForceTSOValidRanges.Contains({Block.Entry, Block.Entry + Block.Size})) {
         if (auto It = ForceTSOInstructions.lower_bound(Block.Entry); It != ForceTSOInstructions.end() && *It < Block.Entry + Block.Size) {
@@ -668,8 +669,12 @@ ContextImpl::GenerateIR(FEXCore::Core::InternalThreadState* Thread, uint64_t Gue
           BlockInForceTSOValidRange = true;
         }
       }
+      if (!BlockInForceTSOValidRange && TSODisabledRanges.Contains({Block.Entry, Block.Entry + Block.Size})) {
+        InstForceTSOIt = ForceTSOInstructions.lower_bound(Block.Entry);
+        BlockInTSODisabledRange = true;
+      }
 
-      Thread->OpDispatcher->ResetMetadataLoadOrder(BlockInForceTSOValidRange);
+      Thread->OpDispatcher->ResetMetadataLoadOrder(BlockInForceTSOValidRange || BlockInTSODisabledRange);
 
       // Set the block entry point
       Thread->OpDispatcher->SetNewBlockIfChanged(Block.Entry);
@@ -767,6 +772,13 @@ ContextImpl::GenerateIR(FEXCore::Core::InternalThreadState* Thread, uint64_t Gue
             } else {
               ForceTSO = IR::ForceTSOMode::ForceDisabled;
             }
+          } else if (BlockInTSODisabledRange) {
+            if ((InstForceTSOIt != ForceTSOInstructions.end() && *InstForceTSOIt == InstAddress) ||
+                (DecodedInfo->Flags & X86Tables::DecodeFlags::FLAG_FORCE_TSO)) {
+              ForceTSO = IR::ForceTSOMode::ForceEnabled;
+            } else {
+              ForceTSO = IR::ForceTSOMode::ForceDisabledGPR;
+            }
           } else if (DecodedInfo->Flags & X86Tables::DecodeFlags::FLAG_FORCE_TSO) {
             ForceTSO = IR::ForceTSOMode::ForceEnabled;
           }
@@ -1507,10 +1519,16 @@ void ContextImpl::AddForceTSOInformation(const IntervalList<uint64_t>& ValidRang
   ForceTSOInstructions.merge(std::move(Instructions));
 }
 
+void ContextImpl::AddTSODisabledRanges(const IntervalList<uint64_t>& Ranges) {
+  LogMan::Throw::AFmt(CodeInvalidationMutex.try_lock() == false, "CodeInvalidationMutex needs to be unique_locked here");
+  TSODisabledRanges.Insert(Ranges);
+}
+
 void ContextImpl::RemoveForceTSOInformation(uint64_t Address, uint64_t Size) {
   LogMan::Throw::AFmt(CodeInvalidationMutex.try_lock() == false, "CodeInvalidationMutex needs to be unique_locked here");
 
   ForceTSOValidRanges.Remove({Address, Address + Size});
+  TSODisabledRanges.Remove({Address, Address + Size});
   ForceTSOInstructions.erase(ForceTSOInstructions.lower_bound(Address), ForceTSOInstructions.upper_bound(Address + Size));
 }
 
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
