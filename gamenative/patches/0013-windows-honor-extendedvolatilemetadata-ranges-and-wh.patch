 FEXCore/Source/Interface/Context/Context.h    |  3 +
 FEXCore/Source/Interface/Core/Core.cpp        | 20 +++++-
 .../Source/Interface/Core/OpcodeDispatcher.h  |  5 +-
 FEXCore/include/FEXCore/Core/Context.h        | 10 +++
 Source/Common/VolatileMetadata.h              | 32 +++++++++
 Source/Windows/Common/ImageTracker.cpp        | 19 ++++++
 .../APITests/ExtendedVolatileMetadata.cpp     | 68 +++++++++++++++++++
 8 files changed, 164 insertions(+), 3 deletions(-)

diff --git a/FEXCore/Source/Interface/Config/Config.json.in b/FEXCore/Source/Interface/Config/Config.json.in
index 602b2a50d..a6451085b 100644
--- a/FEXCore/Source/Interface/Config/Config.json.in
+++ b/FEXCore/Source/Interface/Config/Config.json.in
@@ -751,7 +751,15 @@
           "  * Disable TSO for a part of the module, but enable TSO for some instructions within the module",
           "      `hl2_linux;<offset begin>-<offset-end>;<instruction offset>,<instruction offset>`",
           "  * Disable TSO for multiple modules",
-          "      `hl2_linux:libsdl2.so`"
+          "      `hl2_linux:libsdl2.so`",
+          "On WoW64/arm64ec a range or whole-module entry takes effect on its own: a block that lies entirely inside it",
+          "is translated without TSO for integer loads and stores, except listed instructions. A block that crosses",
+          "a range boundary keeps TSO. Ranges are end exclusive.",
+          "On WoW64/arm64ec a module can also be named by its image ID, `<lowercase file name>-<16 hex digits>`,",
+          "the XXH3-64 hash of the lowercase file name XOR (SizeOfImage << 32 | TimeDateStamp), as printed in the",
+          "`Load module` log line. Such an entry applies only to that build of the module; another build of it",
+          "is left alone and logged.",
+          "      `unityplayer.dll-5695747efd732d16;1000-2000`"
         ]
       }
     }
diff --git a/FEXCore/Source/Interface/Context/Context.h b/FEXCore/Source/Interface/Context/Context.h
index d8834c6ef..d8a0b1b51 100644
--- a/FEXCore/Source/Interface/Context/Context.h
