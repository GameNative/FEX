 };
 
@@ -2585,7 +2586,7 @@ private:
   // x86 keeps loads in program order: a metadata-forced TSO load must not let earlier plain loads complete after it.
   void OrderMetadataLoad(bool AtomicTSO) {
     if (!AtomicTSO) {
-      MetadataPlainLoadPending |= ForceTSO == ForceTSOMode::ForceDisabled;
+      MetadataPlainLoadPending |= ForceTSO == ForceTSOMode::ForceDisabled || ForceTSO == ForceTSOMode::ForceDisabledGPR;
     } else if (ForceTSO == ForceTSOMode::ForceEnabled && MetadataPlainLoadPending) {
       _Fence(FenceType::Load);
       MetadataPlainLoadPending = false;
@@ -2598,6 +2599,8 @@ private:
       return true;
     } else if (ForceTSO == ForceTSOMode::ForceDisabled) {
       return false;
+    } else if (ForceTSO == ForceTSOMode::ForceDisabledGPR && Class == RegClass::GPR) {
+      return false;
     } else if (Class == RegClass::FPR) {
       return CTX->IsVectorAtomicTSOEnabled();
     } else {
diff --git a/FEXCore/include/FEXCore/Core/Context.h b/FEXCore/include/FEXCore/Core/Context.h
index 3524bcede..178463463 100644
--- a/FEXCore/include/FEXCore/Core/Context.h
+++ b/FEXCore/include/FEXCore/Core/Context.h
@@ -195,6 +195,16 @@ public:
    */
   FEX_DEFAULT_VISIBILITY virtual void AddForceTSOInformation(const IntervalList<uint64_t>& ValidRanges, fextl::set<uint64_t>&& Instructions) = 0;
 
+  /**
+   * @brief Adds address ranges whose integer loads and stores need no TSO emulation, without per-instruction information.
+   *
+   * A block that lies entirely inside these ranges is translated without TSO for its integer accesses, except for
+   * instructions listed through AddForceTSOInformation. A block that crosses a range boundary keeps TSO.
+   *
+   * @param Ranges The address ranges, end exclusive
+   */
+  FEX_DEFAULT_VISIBILITY virtual void AddTSODisabledRanges(const IntervalList<uint64_t>& Ranges) = 0;
+
   FEX_DEFAULT_VISIBILITY virtual void RemoveForceTSOInformation(uint64_t Address, uint64_t Size) = 0;
 
   FEX_DEFAULT_VISIBILITY virtual void MarkMonoDetected() = 0;
diff --git a/Source/Common/VolatileMetadata.h b/Source/Common/VolatileMetadata.h
index a6141fe1b..b9a0e95d2 100644
--- a/Source/Common/VolatileMetadata.h
+++ b/Source/Common/VolatileMetadata.h
@@ -6,6 +6,8 @@
 #include <FEXCore/fextl/set.h>
 #include <FEXCore/fextl/string.h>
 
+#include <algorithm>
+#include <cctype>
 #include <string_view>
 
 namespace FEX::VolatileMetadata {
@@ -48,4 +50,34 @@ inline void ApplyFEXExtendedVolatileMetadata(FEX::VolatileMetadata::ExtendedVola
   }
 }
 
+// Option ranges and whole-module entries need no listed instruction to take effect, so they are kept apart from PE volatile metadata.
+inline void ApplyFEXExtendedTSODisabledRanges(const FEX::VolatileMetadata::ExtendedVolatileMetadata& ExtendedMetaData,
+                                              FEXCore::IntervalList<uint64_t>& TSODisabledRanges, uint64_t Address, uint64_t EndAddress) {
+  if (ExtendedMetaData.ModuleTSODisabled) {
+    TSODisabledRanges.Insert({Address, EndAddress});
+    return;
+  }
+
+  for (const auto it_ranges : ExtendedMetaData.VolatileValidRanges) {
+    if (it_ranges.Offset < it_ranges.End && it_ranges.End <= EndAddress - Address) {
+      TSODisabledRanges.Insert({Address + it_ranges.Offset, Address + it_ranges.End});
+    } else {
+      LogMan::Msg::IFmt("ExtendedVolatileMetadata: range 0x{:x}-0x{:x} does not fit in the module [0x{:x}, 0x{:x}), ignored", it_ranges.Offset,
+                        it_ranges.End, Address, EndAddress);
+    }
+  }
+}
+
+// An entry keyed by image ID (`<lowercase module name>-<16 hex digits>`, see CodeMap::GetBaseFilename) for the module whose
+// ID is ImageId, but naming another build of it: a different TimeDateStamp or SizeOfImage.
+inline bool IsOtherImageIdOfModule(std::string_view Key, std::string_view ImageId) {
+  constexpr size_t HashDigits = 16;
+  if (ImageId.size() <= HashDigits + 1 || Key.size() != ImageId.size() || Key == ImageId) {
+    return false;
+  }
+  const auto NamePrefix = ImageId.substr(0, ImageId.size() - HashDigits);
+  return Key.starts_with(NamePrefix) &&
+         std::ranges::all_of(Key.substr(NamePrefix.size()), [](char c) { return std::isxdigit(static_cast<unsigned char>(c)) != 0; });
+}
+
 } // namespace FEX::VolatileMetadata
diff --git a/Source/Windows/Common/ImageTracker.cpp b/Source/Windows/Common/ImageTracker.cpp
index fbe74eef2..82f52e13f 100644
--- a/Source/Windows/Common/ImageTracker.cpp
+++ b/Source/Windows/Common/ImageTracker.cpp
@@ -151,6 +151,25 @@ FEXCore::ExecutableFileSectionInfo ImageTracker::HandleImageMap(std::string_view
   auto ID = FEXCore::CodeMap::GetBaseFilename(ImageInfo->Info, false);
   LogMan::Msg::DFmt("Load module {} ({}): {:X}", ModuleName, ID, Address);
 
+  if (FEXCore::Config::Get_VOLATILEMETADATA()) {
+    const uint64_t EndAddress = Address + Nt->OptionalHeader.SizeOfImage;
+    FEXCore::IntervalList<uint64_t> TSODisabledRanges {};
+    for (const auto& Key : {ID, ModuleName}) {
+      if (auto It = ExtendedMetaData.find(Key); It != ExtendedMetaData.end()) {
+        FEX::VolatileMetadata::ApplyFEXExtendedTSODisabledRanges(It->second, TSODisabledRanges, Address, EndAddress);
+        LogMan::Msg::IFmt("ExtendedVolatileMetadata: applied {} to {} at {:X}", Key, ModuleName, Address);
+      }
+    }
+    for (const auto& [Key, Entry] : ExtendedMetaData) {
+      if (FEX::VolatileMetadata::IsOtherImageIdOfModule(Key, ID)) {
+        LogMan::Msg::IFmt("ExtendedVolatileMetadata: ignored {}, the loaded {} is {}", Key, ModuleName, ID);
+      }
+    }
+    if (!TSODisabledRanges.Empty()) {
+      CTX.AddTSODisabledRanges(TSODisabledRanges);
+    }
+  }
+
   if (FEXCore::Config::Get_ENABLECODECACHINGWIP() && !IsGeneratingCache) {
     if (MainImage) {
       LARGE_INTEGER Time;
diff --git a/unittests/APITests/ExtendedVolatileMetadata.cpp b/unittests/APITests/ExtendedVolatileMetadata.cpp
index 4c0654828..42b940984 100644
--- a/unittests/APITests/ExtendedVolatileMetadata.cpp
+++ b/unittests/APITests/ExtendedVolatileMetadata.cpp
@@ -156,3 +156,71 @@ TEST_CASE("Basic - Double - offset") {
     }
   }
 }
+
+TEST_CASE("Image ID - Key") {
+  const auto String = "unityplayer.dll-5695747efd732d16;1000-2000,3000-3100";
+  const auto Result = FEX::VolatileMetadata::ParseExtendedVolatileMetadata(String);
+  REQUIRE(Result.size() == 1);
+  REQUIRE(Result.contains("unityplayer.dll-5695747efd732d16"));
+  CHECK(Result.at("unityplayer.dll-5695747efd732d16").ModuleTSODisabled == false);
+  CHECK(Result.at("unityplayer.dll-5695747efd732d16").VolatileInstructions.empty());
+
+  const std::vector<std::pair<uint64_t, uint64_t>> ValidRanges = {
+    {0x1000, 0x2000},
+    {0x3000, 0x3100},
+  };
+
+  size_t Count = 0;
+  for (auto it : Result.at("unityplayer.dll-5695747efd732d16").VolatileValidRanges) {
+    CHECK(ContainsRange(std::make_pair(it.Offset, it.End), ValidRanges));
+    ++Count;
+  }
+  CHECK(Count == ValidRanges.size());
+}
+
+TEST_CASE("Image ID - Other build of the module") {
+  const std::string_view Loaded = "unityplayer.dll-5695747efd732d16";
+  CHECK(FEX::VolatileMetadata::IsOtherImageIdOfModule("unityplayer.dll-0123456789abcdef", Loaded));
+  CHECK_FALSE(FEX::VolatileMetadata::IsOtherImageIdOfModule(Loaded, Loaded));
+  CHECK_FALSE(FEX::VolatileMetadata::IsOtherImageIdOfModule("unityplayer.dll", Loaded));
+  CHECK_FALSE(FEX::VolatileMetadata::IsOtherImageIdOfModule("gameassembly.dll-0123456789abcdef", Loaded));
+  CHECK_FALSE(FEX::VolatileMetadata::IsOtherImageIdOfModule("unityplayer.dll-0123456789abcdeg", Loaded));
+  CHECK_FALSE(FEX::VolatileMetadata::IsOtherImageIdOfModule("unityplayer.dll-0123456789abcde", Loaded));
+}
+
+TEST_CASE("TSO disabled ranges - offsets") {
+  const auto Result = FEX::VolatileMetadata::ParseExtendedVolatileMetadata("UnityPlayer.dll;1000-1800,3000-3010,1fff0-20010");
+  FEXCore::IntervalList<uint64_t> Ranges {};
+  FEX::VolatileMetadata::ApplyFEXExtendedTSODisabledRanges(Result.at("UnityPlayer.dll"), Ranges, 0x7ff800000000, 0x7ff800020000);
+
+  CHECK(Ranges.Contains({0x7ff800001000, 0x7ff800001800}));
+  CHECK(Ranges.Contains({0x7ff800003000, 0x7ff800003010}));
+  // A block crossing a range boundary is not covered.
+  CHECK_FALSE(Ranges.Contains({0x7ff8000017f0, 0x7ff800001810}));
+  CHECK_FALSE(Ranges.Contains({0x7ff800000ff0, 0x7ff800001010}));
+  CHECK_FALSE(Ranges.Contains({0x7ff800002000, 0x7ff800002010}));
+  // A range past the end of the module is dropped.
+  CHECK_FALSE(Ranges.Intersect({0x7ff80001fff0, 0x7ff800020000}));
+}
+
+TEST_CASE("TSO disabled ranges - whole module") {
+  const auto Result = FEX::VolatileMetadata::ParseExtendedVolatileMetadata("UnityPlayer.dll");
+  FEXCore::IntervalList<uint64_t> Ranges {};
+  FEX::VolatileMetadata::ApplyFEXExtendedTSODisabledRanges(Result.at("UnityPlayer.dll"), Ranges, 0x180000000, 0x181e65000);
+
+  CHECK(Ranges.Contains({0x180000000, 0x181e65000}));
+  CHECK_FALSE(Ranges.Contains({0x181e64ff0, 0x181e65010}));
+}
+
+TEST_CASE("TSO disabled ranges - instructions keep their PE metadata form") {
+  auto Result = FEX::VolatileMetadata::ParseExtendedVolatileMetadata("UnityPlayer.dll;1000-2000;1010");
+  fextl::set<uint64_t> Instructions {};
+  FEXCore::IntervalList<uint64_t> ValidRanges {};
+  FEXCore::IntervalList<uint64_t> Ranges {};
+  FEX::VolatileMetadata::ApplyFEXExtendedVolatileMetadata(Result.at("UnityPlayer.dll"), Instructions, ValidRanges, 0x10000, 0x20000);
+  FEX::VolatileMetadata::ApplyFEXExtendedTSODisabledRanges(Result.at("UnityPlayer.dll"), Ranges, 0x10000, 0x20000);
+
+  CHECK(Instructions.contains(0x11010));
+  CHECK(ValidRanges.Contains({0x11000, 0x12000}));
+  CHECK(Ranges.Contains({0x11000, 0x12000}));
+}
