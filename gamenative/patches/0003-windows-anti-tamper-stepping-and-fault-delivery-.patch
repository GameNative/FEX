+static uint64_t HashDecodedBlocks(const FEXCore::Frontend::Decoder::DecodedBlockInformation* BlockInfo) {
+  uint64_t H = 0x9E3779B97F4A7C15ULL ^ BlockInfo->Blocks.size();
+  auto Mix = [&H](uint64_t V) {
+    H ^= V;
+    H *= 0xff51afd7ed558ccdULL;
+    H ^= H >> 32;
+  };
+  for (const auto& Block : BlockInfo->Blocks) {
+    Mix(Block.Entry);
+    Mix(Block.Size);
+    const auto* P = reinterpret_cast<const uint8_t*>(Block.Entry);
+    uint64_t i = 0;
+    for (; i + 8 <= Block.Size; i += 8) {
+      uint64_t V;
+      memcpy(&V, P + i, sizeof(V));
+      Mix(V);
+    }
+    uint64_t Tail = 0;
+    if (i < Block.Size) {
+      memcpy(&Tail, P + i, Block.Size - i);
+    }
+    Mix(Tail ^ (Block.Size - i) << 56);
+  }
+  return H;
+}
