+// Puts back the translation of GuestRIP from the current code buffer when the guest bytes it was compiled from are back
+// (same decode, same hash). Returns 0 (decoder reset for a normal compile) otherwise.
+uintptr_t ContextImpl::TryReuseBlock(FEXCore::Core::InternalThreadState* Thread, uint64_t GuestRIP, uint64_t MaxInst) {
+  if (Thread->CurrentFrame->State.flags[X86State::RFLAG_TF_RAW_LOC]) {
+    return 0;
+  }
+  ReuseEntry Entry;
+  {
+    std::scoped_lock lk(ReuseCacheMutex);
+    auto It = ReuseCache.find(GuestRIP);
+    if (It == ReuseCache.end()) {
+      return 0;
+    }
+    Entry = It->second;
+  }
+  __atomic_fetch_add(&CodeReuseStats.Lookups, 1, __ATOMIC_RELAXED);
+  if (Entry.Buffer != Thread->CPUBackend->GetCurrentCodeBufferPtr() || Entry.Generation != Thread->CPUBackend->GetCurrentCodeBufferGeneration()) {
+    __atomic_fetch_add(&CodeReuseStats.OtherBuffer, 1, __ATOMIC_RELAXED);
+    return 0;
+  }
+
+  Thread->FrontendDecoder->DecodeLoop(reinterpret_cast<const uint8_t*>(GuestRIP));
+  const auto* BlockInfo = Thread->FrontendDecoder->GetDecodedBlockInfo();
+  if (HashDecodedBlocks(BlockInfo) != Entry.Hash) {
+    __atomic_fetch_add(&CodeReuseStats.Mismatch, 1, __ATOMIC_RELAXED);
+    Thread->FrontendDecoder->SetupDecodeInstructionsAtEntry(Thread, GuestRIP, MaxInst);
+    return 0;
+  }
+
+  fextl::vector<uint64_t> CodePages(BlockInfo->CodePages.begin(), BlockInfo->CodePages.end());
+  for (auto CodePage : CodePages) {
+    if (Thread->LookupCache->AddBlockExecutableRange(Thread, BlockInfo->EntryPoints, CodePage, FEXCore::Utils::FEX_PAGE_SIZE)) {
+      SyscallHandler->MarkGuestExecutableRange(Thread, CodePage, FEXCore::Utils::FEX_PAGE_SIZE);
+    }
+  }
+  Thread->LookupCache->AddBlockMapping(Thread, GuestRIP, CodePages, reinterpret_cast<void*>(Entry.Host));
+  __atomic_fetch_add(&CodeReuseStats.Hits, 1, __ATOMIC_RELAXED);
+
+  Thread->FrontendDecoder->DelayedDisownBuffer();
+  Thread->FrontendDecoder->ValidateDisownedOrFree();
+  Thread->OpDispatcher->ValidateDisownedOrFree();
+  return Entry.Host;
+}
