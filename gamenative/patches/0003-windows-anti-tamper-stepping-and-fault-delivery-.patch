+extern "C" NTSTATUS NtQueryVirtualMemoryHooked(HANDLE Process, LPCVOID Address, MEMORY_INFORMATION_CLASS Class, PVOID Buffer,
+                                               SIZE_T Length, SIZE_T* ResultLength) {
+  const NTSTATUS Status = NtQueryVirtualMemoryNative(Process, Address, Class, Buffer, Length, ResultLength);
+  if (Status || !InvalidationTracker || !IsCurrentProcess(Process)) {
+    return Status;
+  }
+  __atomic_fetch_add(&SmcHideStats.QueriesFiltered, 1, __ATOMIC_RELAXED);
+
+  if ((Class == MemoryBasicInformation || Class == MemoryBasicInformationCapped) && Length >= sizeof(MEMORY_BASIC_INFORMATION)) {
+    if (FixupBasicInformation(static_cast<MEMORY_BASIC_INFORMATION*>(Buffer))) {
+      __atomic_fetch_add(&SmcHideStats.QueriesCorrected, 1, __ATOMIC_RELAXED);
+    }
+  } else if (Class == MemoryWorkingSetExInformation) {
+    auto* Entries = static_cast<WorkingSetExEntry*>(Buffer);
+    for (SIZE_T i = 0; i < Length / sizeof(WorkingSetExEntry); i++) {
+      if (!(Entries[i].Attributes & 1)) {
+        continue;
+      }
+      const ULONG Prot = (Entries[i].Attributes >> 4) & 0x7ff;
+      const ULONG Visible = InvalidationTracker->GuestVisibleProtection(reinterpret_cast<uint64_t>(Entries[i].VirtualAddress), Prot);
+      if (Visible != Prot) {
+        __atomic_fetch_add(&SmcHideStats.QueriesCorrected, 1, __ATOMIC_RELAXED);
+      }
+      Entries[i].Attributes = (Entries[i].Attributes & ~(ULONG_PTR(0x7ff) << 4)) | (ULONG_PTR(Visible & 0x7ff) << 4);
+    }
+  }
+  return Status;
+}
+
+extern "C" NTSTATUS NtProtectVirtualMemoryHooked(HANDLE Process, PVOID* AddressPtr, SIZE_T* SizePtr, ULONG NewProt, ULONG* OldProt) {
+  const NTSTATUS Status = NtProtectVirtualMemoryNative(Process, AddressPtr, SizePtr, NewProt, OldProt);
+  if (!Status && OldProt && InvalidationTracker && IsCurrentProcess(Process)) {
+    __atomic_fetch_add(&SmcHideStats.ProtectsFiltered, 1, __ATOMIC_RELAXED);
+    const ULONG Visible = InvalidationTracker->GuestVisibleProtection(reinterpret_cast<uint64_t>(*AddressPtr), *OldProt);
+    if (Visible != *OldProt) {
+      __atomic_fetch_add(&SmcHideStats.ProtectsCorrected, 1, __ATOMIC_RELAXED);
+      *OldProt = Visible;
+    }
+  }
+  return Status;
+}
