+void InvalidationTracker::DetectVolatileRegion(uint64_t FaultAddress) {
+  static const bool Enabled = [] {
+    const char* Value = getenv("FEX_EXP_VOLATILE");
+    return !Value || Value[0] != '0';
+  }();
+  if (!Enabled) {
+    return;
+  }
+  const uint64_t Page = FaultAddress & FEXCore::Utils::FEX_PAGE_MASK;
+  if (CTX.IsVolatileCode(Page)) {
+    return;
+  }
+  const size_t Idx = (Page >> 12) & 1023;
+  if (VolatileFaultPage[Idx] != Page) {
+    VolatileFaultPage[Idx] = Page;
+    VolatileFaultCount[Idx] = 0;
+  }
+  if (++VolatileFaultCount[Idx] < 16) {
+    return;
+  }
+
+  MEMORY_BASIC_INFORMATION Info;
+  if (NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(Page), MemoryBasicInformation, &Info, sizeof(Info), nullptr) ||
+      Info.Type != MEM_PRIVATE) {
+    return;
+  }
+  const uint64_t Base = reinterpret_cast<uint64_t>(Info.AllocationBase);
+  uint64_t Size = reinterpret_cast<uint64_t>(Info.BaseAddress) + Info.RegionSize - Base;
+  while (!NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(Base + Size), MemoryBasicInformation, &Info, sizeof(Info), nullptr) &&
+         reinterpret_cast<uint64_t>(Info.AllocationBase) == Base) {
+    Size += Info.RegionSize;
+  }
+  if (Size > 64ULL * 1024 * 1024) {
+    return;
+  }
+
+  CTX.AddVolatileCodeRegion(Base, Size);
+  if (!CTX.IsVolatileCode(Page)) {
+    return;
+  }
+  LogMan::Msg::IFmt("Volatile code region: {:X} - {:X}", Base, Base + Size);
+
+  // Drop the code compiled there, then give the guest its write permission back on every page FEX trapped.
+  InvalidateIntervalInternalLocked(Base, Size);
+  for (uint64_t Addr = Base; Addr < Base + Size;) {
+    FEXCore::IntervalList<uint64_t>::QueryResult Query;
+    {
+      std::scoped_lock TLock(TrappedLock);
+      Query = TrappedIntervals.Query(Addr);
+    }
+    if (!Query.Size) {
+      break;
+    }
+    const uint64_t End = std::min(Base + Size, Addr + Query.Size);
+    if (Query.Enclosed) {
+      ULONG Prot;
+      {
+        std::shared_lock Lock(IntervalsLock);
+        Prot = GetUntrapProt(Addr);
+      }
+      void* TmpAddress = reinterpret_cast<void*>(Addr);
+      SIZE_T TmpSize = End - Addr;
+      ULONG TmpProt;
+      if (!NtProtectVirtualMemory(NtCurrentProcess(), &TmpAddress, &TmpSize, Prot, &TmpProt)) {
+        ForgetTrapped(Addr, End - Addr);
+      }
+    }
+    Addr = End;
+  }
+}
