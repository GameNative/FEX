+bool ContextImpl::IsVolatileCode(uint64_t Address) const {
+  const uint32_t N = NumVolatileCodeRegions.load(std::memory_order_acquire);
+  for (uint32_t i = 0; i < N; i++) {
+    if (Address >= VolatileCodeRegions[i].Base && Address < VolatileCodeRegions[i].End) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void ContextImpl::AddVolatileCodeRegion(uint64_t Base, uint64_t Size) {
+  std::scoped_lock lk(VolatileCodeMutex);
+  if (IsVolatileCode(Base)) {
+    return;
+  }
+  const uint32_t N = NumVolatileCodeRegions.load(std::memory_order_relaxed);
+  if (N >= 4) {
+    return;
+  }
+  VolatileCodeRegions[N] = {Base, Base + Size};
+  VolatileCodeStats.RegionBase[N] = Base;
+  VolatileCodeStats.RegionSize[N] = Size;
+  VolatileCodeStats.Regions = N + 1;
+  NumVolatileCodeRegions.store(N + 1, std::memory_order_release);
+}
