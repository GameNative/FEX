From 1660b4b4236c3dcdb7e58537a9742cd979cb3a77 Mon Sep 17 00:00:00 2001
From: Utkarsh Dalal <dalal.utkarsh@gmail.com>
Date: Wed, 28 Oct 2026 18:29:24 +0530
Subject: [PATCH 09/10] FEXOfflineCompiler: quote process-all child arguments
 on Windows

_spawnv joins argv with spaces and does not quote the elements, so the
generate subprocess split paths containing spaces (for example a code
map named after "Blazing Chrome.exe" or a cache directory under a
profile path with spaces) into several arguments and failed.

Quote each argument following the CommandLineToArgvW rules before
spawning.
---
 Source/Tools/FEXOfflineCompiler/Main.cpp | 36 ++++++++++++++++++++++--
 1 file changed, 34 insertions(+), 2 deletions(-)

diff --git a/Source/Tools/FEXOfflineCompiler/Main.cpp b/Source/Tools/FEXOfflineCompiler/Main.cpp
index df4e3cd..25f7322 100644
--- a/Source/Tools/FEXOfflineCompiler/Main.cpp
+++ b/Source/Tools/FEXOfflineCompiler/Main.cpp
@@ -387,6 +387,28 @@ static LONG ExceptionHandler(_EXCEPTION_POINTERS* ExceptionInfo) {
   return EXCEPTION_CONTINUE_SEARCH;
 }
 
+// _spawnv joins its arguments with spaces without quoting them
+static std::string QuoteCommandLineArgument(std::string_view Arg) {
+  if (!Arg.empty() && Arg.find_first_of(" \t\n\v\"") == Arg.npos) {
+    return std::string {Arg};
+  }
+
+  std::string Quoted = "\"";
+  size_t NumBackslashes = 0;
+  for (char C : Arg) {
+    if (C == '\\') {
+      ++NumBackslashes;
+      continue;
+    }
+    Quoted.append(C == '"' ? NumBackslashes * 2 + 1 : NumBackslashes, '\\');
+    Quoted += C;
+    NumBackslashes = 0;
+  }
+  Quoted.append(NumBackslashes * 2, '\\');
+  Quoted += '"';
+  return Quoted;
+}
+
 struct winsize {
   int ws_col;
 };
@@ -827,8 +849,18 @@ static int ProcessAll() {
       }
 #else
       GenerateArgs.insert(GenerateArgs.begin(), SelfPath.c_str());
-      GenerateArgs.push_back(nullptr);
-      auto Status = _spawnv(_P_WAIT, SelfPath.c_str(), GenerateArgs.data());
+      std::vector<std::string> QuotedArgs;
+      QuotedArgs.reserve(GenerateArgs.size());
+      for (auto* Arg : GenerateArgs) {
+        QuotedArgs.push_back(QuoteCommandLineArgument(Arg));
+      }
+      std::vector<const char*> SpawnArgs;
+      SpawnArgs.reserve(QuotedArgs.size() + 1);
+      for (auto& Arg : QuotedArgs) {
+        SpawnArgs.push_back(Arg.c_str());
+      }
+      SpawnArgs.push_back(nullptr);
+      auto Status = _spawnv(_P_WAIT, SelfPath.c_str(), SpawnArgs.data());
       if (Status) {
         fmt::println("ERROR: Cache generation failed for {}", BinaryName);
       }
-- 
