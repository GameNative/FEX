--- a/FEXCore/include/FEXCore/Core/CoreState.h
+++ b/FEXCore/include/FEXCore/Core/CoreState.h
@@ -472,12 +472,20 @@ struct CpuStateFrame {
 
   // Pointers that the JIT needs to load to remove relocations
   JITPointers Pointers;
+
+  // Code map indirect branch sampling (CodeMapIndirectBranches): guest RIP of the indirect branch whose
+  // target missed the L1 cache, dispatcher passes left until the next sampling call, and the per-thread
+  // table of {site, target} pairs already reported.
+  uint64_t IndirectBranchSite {};
+  uint64_t IndirectBranchCountdown {};
+  uint64_t* IndirectBranchSeen {};
 };
 static_assert(offsetof(CpuStateFrame, State) == 0, "CPUState must be first member in CpuStateFrame");
 static_assert(offsetof(CpuStateFrame, Pointers) % 8 == 0, "JITPointers need to be aligned to 8 bytes");
 static_assert(offsetof(CpuStateFrame, Pointers) + sizeof(CpuStateFrame::Pointers) <= 32760, "JITPointers maximum pointer needs to be less "
                                                                                             "than architecture maximum 32768");
 
+static_assert(offsetof(CpuStateFrame, IndirectBranchSeen) <= 32760, "Indirect branch sampling fields need an ldr immediate offset");
 static_assert(std::is_standard_layout<CpuStateFrame>::value, "This needs to be standard layout");
 static_assert(sizeof(CpuStateFrame::SynchronousFaultData) == 16, "This needs to be 16 bytes");
 static_assert(alignof(CpuStateFrame::SynchronousFaultDataStruct) == 8, "This needs to be 8 bytes");
diff --git a/FEXCore/include/FEXCore/Debug/InternalThreadState.h b/FEXCore/include/FEXCore/Debug/InternalThreadState.h
index 935c7cb73..cb8f69da2 100644
--- a/FEXCore/include/FEXCore/Debug/InternalThreadState.h
+++ b/FEXCore/include/FEXCore/Debug/InternalThreadState.h
@@ -118,6 +118,9 @@ struct alignas(FEXCore::Utils::FEX_PAGE_SIZE) InternalThreadState : public FEXCo
   uint64_t VolatileEntryRIP {};
   // Hash of the guest bytes of the last decoded compile unit (see ContextImpl::TryReuseBlock).
   uint64_t ReuseDecodeHash {};
+  // Code map indirect branch sampling (see ContextImpl::SampleIndirectBranch).
+  uint64_t IndirectResampleLastMS {};
+  uint64_t IndirectResampleCursor {};
 
   uintptr_t JITGuardPage {};
   uint64_t JITGuardOverflowArgument {};
