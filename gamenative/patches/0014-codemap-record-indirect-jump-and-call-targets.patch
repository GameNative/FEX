+  // Drops Count L1 entries starting at Cursor (wrapping at the current L1 size) and advances Cursor.
+  // Only called by the thread that owns this cache; empty entries are not written so unused pages stay untouched.
+  void DropL1Slice(uint64_t& Cursor, size_t Count) {
+    auto Entries = reinterpret_cast<LookupCacheEntry*>(L1Pointer);
+    for (size_t i = 0; i < Count; ++i) {
+      auto& Entry = Entries[(Cursor + i) & L1PointerMask];
+      if (Entry.GuestCode) {
+        Entry.GuestCode = 0;
+      }
+    }
+    Cursor += Count;
+  }
