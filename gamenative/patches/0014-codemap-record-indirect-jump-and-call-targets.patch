+    Thread->CurrentFrame->IndirectBranchCountdown = IndirectBranchSampleDispatches;
+    Thread->CurrentFrame->IndirectBranchSite = 0;
+    auto NowMS = static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+    uint64_t Unset = 0;
+    __atomic_compare_exchange_n(&IndirectSampleStartMS, &Unset, NowMS, false, __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+    Thread->IndirectResampleLastMS = NowMS;
+  }
+
   return Thread;
 }
 
+uint64_t ContextImpl::SampleIndirectBranch(FEXCore::Core::CpuStateFrame* Frame) {
+  auto Thread = Frame->Thread;
+  auto CTX = static_cast<ContextImpl*>(Thread->CTX);
+  Frame->IndirectBranchCountdown = IndirectBranchSampleDispatches;
+
+  const uint64_t Site = Frame->IndirectBranchSite;
+  if (Site) {
+    Frame->IndirectBranchSite = 0;
+    const uint64_t Target = Frame->State.rip;
+    auto Slot = &Frame->IndirectBranchSeen[IndirectBranchSeenIndex(Site, Target) * 2];
+    Slot[0] = Site;
+    Slot[1] = Target;
+    if (CTX->CodeMapWriter) {
+      CTX->RecordIndirectBranch(Thread, Site, Target);
+    }
+  }
+
+  CTX->ResampleIndirectBranches(Thread);
+  return 0;
+}
+
+void ContextImpl::RecordIndirectBranch(FEXCore::Core::InternalThreadState* Thread, uint64_t Site, uint64_t Target) {
+  {
+    std::scoped_lock lk(IndirectBranchPairsMutex);
+    if (IndirectBranchPairs.size() >= MaxIndirectBranchPairs || !IndirectBranchPairs.emplace(Site, Target).second) {
+      return;
+    }
+  }
+
+  auto SiteSection = SyscallHandler->LookupExecutableFileSection(Thread, Site);
+  if (!SiteSection || SiteSection->FileStartVA == 0) {
+    return;
+  }
+  auto TargetSection = SyscallHandler->LookupExecutableFileSection(Thread, Target);
+  if (!TargetSection || TargetSection->FileStartVA == 0) {
+    return;
+  }
+  CodeMapWriter->AppendIndirectBranch(*SiteSection, Site, *TargetSection, Target);
+}
+
+void ContextImpl::ResampleIndirectBranches(FEXCore::Core::InternalThreadState* Thread) {
+  const uint64_t IntervalMS = Config.CodeMapIndirectResampleMS;
+  if (!IntervalMS) {
+    return;
+  }
+  const auto NowMS = static_cast<uint64_t>(
+    std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+  const bool Early = NowMS - __atomic_load_n(&IndirectSampleStartMS, __ATOMIC_RELAXED) < 120'000;
+  if (NowMS - Thread->IndirectResampleLastMS < (Early ? IntervalMS / 8 : IntervalMS)) {
+    return;
+  }
+  Thread->IndirectResampleLastMS = NowMS;
+  Thread->LookupCache->DropL1Slice(Thread->IndirectResampleCursor, IndirectResampleSliceEntries);
+}
+
 void ContextImpl::DestroyThread(FEXCore::Core::InternalThreadState* Thread) {
+  if (Thread->CurrentFrame->IndirectBranchSeen) {
+    FEXCore::Allocator::free(Thread->CurrentFrame->IndirectBranchSeen);
+    Thread->CurrentFrame->IndirectBranchSeen = nullptr;
+  }
   FEXCore::Allocator::VirtualProtect(&Thread->InterruptFaultPage, sizeof(Thread->InterruptFaultPage),
                                      Allocator::ProtectOptions::Read | Allocator::ProtectOptions::Write);
   delete Thread;
