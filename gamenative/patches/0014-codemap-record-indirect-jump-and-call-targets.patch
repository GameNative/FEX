+  static constexpr size_t IndirectResampleSliceEntries = 4096;
+  static constexpr size_t MaxIndirectBranchPairs = 1 << 20;
+  static uint64_t IndirectBranchSeenIndex(uint64_t Site, uint64_t Target) {
+    return (Site ^ std::rotr(Target, 7)) & (IndirectBranchSeenEntries - 1);
+  }
