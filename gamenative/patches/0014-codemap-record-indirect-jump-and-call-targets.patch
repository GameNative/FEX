   // Clobbers TMP1/2
   // Check the EC code bitmap incase we need to exit the JIT to call into native code.
@@ -348,6 +364,39 @@ void Dispatcher::EmitDispatcher() {
     br(TMP1);
   }
 
+  if (SampleIndirectBranches) {
+    // Pairs already in this thread's table skip the call. Flags are live, so compare with sub + cbnz.
+    (void)Bind(&l_IndirectSite);
+    ldr(TMP2, STATE_PTR(CpuStateFrame, IndirectBranchSeen));
+    eor(ARMEmitter::Size::i64Bit, TMP4, TMP1, RipReg, ARMEmitter::ShiftType::ROR, 7);
+    and_(ARMEmitter::Size::i64Bit, TMP4, TMP4, FEXCore::Context::ContextImpl::IndirectBranchSeenEntries - 1);
+    add(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP4, ARMEmitter::ShiftType::LSL, 4);
+    ldr(TMP4, TMP2, 0);
+    sub(TMP4, TMP4, TMP1);
+    (void)cbnz(ARMEmitter::Size::i64Bit, TMP4, &l_IndirectSample);
+    ldr(TMP4, TMP2, 8);
+    sub(TMP4, TMP4, RipReg);
+    (void)cbnz(ARMEmitter::Size::i64Bit, TMP4, &l_IndirectSample);
+    str(ARMEmitter::XReg::zr, STATE_PTR(CpuStateFrame, IndirectBranchSite));
+    (void)b(&l_IndirectSiteDone);
+
+    (void)Bind(&l_IndirectSample);
+    EmitSignalGuardedRegion([&]() {
+      SpillStaticRegs(TMP1);
+
+      mov(ARMEmitter::XReg::x0, STATE);
+      ldr(ARMEmitter::XReg::x1, &l_IndirectSampleHandler);
+      if (!CTX->Config.DisableVixlIndirectCalls) [[unlikely]] {
+        GenerateIndirectRuntimeCall<uint64_t, void*>(ARMEmitter::Reg::r1);
+      } else {
+        blr(ARMEmitter::Reg::r1);
+      }
+
+      FillStaticRegs();
+    });
+    (void)b(&LoopTop);
+  }
+
   {
     (void)Bind(&CompileSingleStep);
 
