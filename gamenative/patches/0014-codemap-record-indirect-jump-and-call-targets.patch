+void CodeMapWriter::AppendIndirectBranch(const FEXCore::ExecutableFileSectionInfo& Site, uint64_t SiteRIP,
+                                         const FEXCore::ExecutableFileSectionInfo& Target, uint64_t TargetRIP) {
+  if (!IsWriteEnabled(Site) || !IsWriteEnabled(Target)) {
+    return;
+  }
+
+  SiteRIP -= Site.FileStartVA;
+  TargetRIP -= Target.FileStartVA;
+  if (SiteRIP > std::numeric_limits<uint32_t>::max() || TargetRIP > std::numeric_limits<uint32_t>::max()) {
+    return;
+  }
+
+  RegisterFile(Site.FileInfo);
+  RegisterFile(Target.FileInfo);
+
+  CodeMap::IndirectBranch Data {
+    CodeMap::IndirectBranch::Marker,
+    {Site.FileInfo.FileId, static_cast<uint32_t>(SiteRIP)},
+    {Target.FileInfo.FileId, static_cast<uint32_t>(TargetRIP)},
+  };
+  AppendData(std::span {reinterpret_cast<const std::byte*>(&Data), sizeof(Data)});
 }
 
